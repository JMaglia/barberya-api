# Copiar a .env y completar. .env no se commitea.

# Secreto para firmar los access tokens (HS256). Mínimo 32 bytes.
# Generarlo con: openssl rand -base64 48
JWT_SECRET=

# Origen del front (CORS y links de los mails).
FRONT_URL=http://localhost:5173

# Client ID de Google (Google Cloud Console > Credenciales > ID de cliente OAuth, tipo web).
GOOGLE_CLIENT_ID=

# --- Mails (SMTP) ---
# En desarrollo no hace falta nada: por defecto se usa Mailpit (localhost:1025, buzón en http://localhost:8025).
# En producción, MAIL_HOST es obligatorio. Ejemplos:
#   Resend: MAIL_HOST=smtp.resend.com     MAIL_USERNAME=resend          MAIL_PASSWORD=<API key>
#   Brevo:  MAIL_HOST=smtp-relay.brevo.com MAIL_USERNAME=<login SMTP>   MAIL_PASSWORD=<clave SMTP>
#   Con los dos: MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# true si el SMTP pide usuario y contraseña.
MAIL_SMTP_AUTH=
# true para exigir STARTTLS (puerto 587).
MAIL_STARTTLS=
# Remitente de los mails. El dominio tiene que estar verificado en el proveedor.
MAIL_FROM=BarberYA <no-responder@barberya.app>
